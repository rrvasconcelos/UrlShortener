# ============================================================
#  .env.example — Copy to .env and fill in your values
#  NEVER commit the .env file to source control!
# ============================================================

# --- Hashids (legacy short-code encoder, kept for backward compat) ---
HASHIDS_SALT=your-unique-salt-here-change-this-in-production
HASHIDS_MIN_LENGTH=7

# --- PostgreSQL ---
POSTGRES_DB=urlshortener_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Connection Strings ---
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=urlshortener_db;Username=postgres;Password=postgres;Include Error Detail=true
REDIS_CONNECTION_STRING=redis:6379

# --- JWT Authentication ---
# SecretKey must be at least 32 characters
JWT_SECRET_KEY=your-super-secret-key-here-min-32-chars
JWT_ISSUER=UrlShortener
JWT_AUDIENCE=UrlShortener
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# --- Snowflake ID Generator ---
# MachineId must be unique per instance (0–1023)
SNOWFLAKE_MACHINE_ID=1

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://*:8080
