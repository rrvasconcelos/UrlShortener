{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hashids": {
    "MinHashLength": 7
  },
  "JwtSettings": {
    "SecretKey": "dev-secret-key-please-change-in-production-must-be-32chars",
    "Issuer": "UrlShortener",
    "Audience": "UrlShortener",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "SnowflakeSettings": {
    "MachineId": 1
  }
}