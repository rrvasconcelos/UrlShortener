FROM node:20-alpine

WORKDIR /app

# Instalar dependências primeiro (para cache de layer)
COPY package*.json ./
RUN npm install

# Copiar código fonte
COPY . .

# Expor porta do Angular dev server
EXPOSE 4200

# Comando para desenvolvimento com hot reload
CMD ["npm", "run", "start", "--", "--port", "4200", "--poll", "2000"]